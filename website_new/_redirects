# Cloudflare Pages _redirects
# Format: /from /to [status]
# Status 200 = REWRITE (URL stays the same, serves different content)
# Status 301/302 = REDIRECT (URL changes in browser)

# CRITICAL: Serve static assets as-is (no redirects)
# These must be FIRST to prevent other rules from catching them
/data/* /data/:splat 200
/assets/* /assets/:splat 200

# Detail pages (REWRITE - URL stays visible)
# Browser shows: /rango/magia_fuego
# Server serves: /_rango.html
/rango/* /_rango 200
/criatura/* /_criatura 200
/equipo/* /_equipo 200

# Mundo sub-pages (REWRITE)
/mundo/categoria/* /_mundo_categoria 200
/mundo/articulo/* /_mundo_articulo 200
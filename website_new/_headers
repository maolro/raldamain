# Headers para asegurar que los archivos JSON se sirvan correctamente
/data/*
  Content-Type: application/json
  X-Content-Type-Options: nosniff

# Headers de seguridad generales
/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Scripts y estilos: el navegador comprueba si hay una versión nueva en cada visita
# (si no ha cambiado, el servidor responde "304" sin volver a enviar el archivo)
/assets/js/*
  Cache-Control: no-cache
/assets/css/*
  Cache-Control: no-cache

# Imágenes de criaturas: el Taller las reemplaza (mismo nombre, <id>.jpg), así que el
# navegador comprueba en cada visita si hay una nueva en vez de guardar la vieja 4 horas
/assets/images/creatures/*
  Cache-Control: no-cache

# Simulador en el navegador (/simulador): el código Python del simulador
/combat-simulator/*
  Cache-Control: no-cache
